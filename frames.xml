<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
	<!--
		Static parchment art of the Storyline window (tiled textures are easiest to declare in XML).
		Texture coordinates and artwork come from the original Storyline (Apache License 2.0,
		Copyright 2015 Sylvain Cossement and Renaud Parize).
	-->

	<!-- Tiled parchment under everything -->
	<Frame name="Storyline_ParchmentBackground" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\AddOns\Storyline\Artwork\QuestionFrame\question-background" vertTile="true" horizTile="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="20" y="-20"/>
						<Anchor point="BOTTOMRIGHT" x="-20" y="20"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<!-- Decorated border drawn above the models -->
	<Frame name="Storyline_ParchmentBorders" virtual="true">
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parentTopLeft" file="Interface\AddOns\Storyline\Artwork\QuestionFrame\Question-Main">
					<Size x="209" y="158"/>
					<Anchors><Anchor point="TOPLEFT" x="0" y="0"/></Anchors>
					<TexCoords left="0.00195313" right="0.41015625" top="0.61718750" bottom="0.92578125"/>
				</Texture>
				<Texture name="$parentTopRight" file="Interface\AddOns\Storyline\Artwork\QuestionFrame\Question-Main">
					<Size x="209" y="158"/>
					<Anchors><Anchor point="TOPRIGHT" x="0" y="0"/></Anchors>
					<TexCoords left="0.41406250" right="0.82031250" top="0.61718750" bottom="0.92578125"/>
				</Texture>
				<Texture name="$parentBottomLeft" file="Interface\AddOns\Storyline\Artwork\QuestionFrame\Question-Main">
					<Size x="209" y="158"/>
					<Anchors><Anchor point="BOTTOMLEFT" x="0" y="0"/></Anchors>
					<TexCoords left="0.00195313" right="0.41015625" top="0.30468750" bottom="0.61328125"/>
				</Texture>
				<Texture name="$parentBottomRight" file="Interface\AddOns\Storyline\Artwork\QuestionFrame\Question-Main">
					<Size x="209" y="158"/>
					<Anchors><Anchor point="BOTTOMRIGHT" x="0" y="0"/></Anchors>
					<TexCoords left="0.41406250" right="0.82226563" top="0.30468750" bottom="0.61328125"/>
				</Texture>

				<Texture name="$parentLeft" file="Interface\AddOns\Storyline\Artwork\QuestionFrame\Question-VTile" vertTile="true">
					<Size x="93" y="256"/>
					<Anchors>
						<Anchor point="LEFT" x="2" y="0"/>
						<Anchor point="TOP" relativeTo="$parentTopLeft" relativePoint="BOTTOM"/>
						<Anchor point="BOTTOM" relativeTo="$parentBottomLeft" relativePoint="TOP"/>
					</Anchors>
					<TexCoords left="0.00390625" right="0.36718750" top="0.00000000" bottom="1.00000000"/>
				</Texture>
				<Texture name="$parentRight" file="Interface\AddOns\Storyline\Artwork\QuestionFrame\Question-VTile" vertTile="true">
					<Size x="94" y="256"/>
					<Anchors>
						<Anchor point="RIGHT" x="0" y="0"/>
						<Anchor point="TOP" relativeTo="$parentTopRight" relativePoint="BOTTOM"/>
						<Anchor point="BOTTOM" relativeTo="$parentBottomRight" relativePoint="TOP"/>
					</Anchors>
					<TexCoords left="0.37500000" right="0.74218750" top="0.00000000" bottom="1.00000000"/>
				</Texture>
				<Texture name="$parentBottom" file="Interface\AddOns\Storyline\Artwork\QuestionFrame\Question-HTile" horizTile="true">
					<Size x="256" y="86"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeTo="$parentBottomLeft" relativePoint="BOTTOMRIGHT" x="0" y="2"/>
						<Anchor point="BOTTOMRIGHT" relativeTo="$parentBottomRight" relativePoint="BOTTOMLEFT" x="0" y="2"/>
					</Anchors>
					<TexCoords left="0.00000000" right="1.00000000" top="0.17187500" bottom="0.33984375"/>
				</Texture>
				<Texture name="$parentTop" file="Interface\AddOns\Storyline\Artwork\QuestionFrame\Question-HTile" horizTile="true">
					<Size x="256" y="91"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentTopLeft" relativePoint="TOPRIGHT" x="0" y="-1"/>
						<Anchor point="TOPRIGHT" relativeTo="$parentTopRight" relativePoint="TOPLEFT" x="0" y="-1"/>
					</Anchors>
					<TexCoords left="0.00000000" right="1.00000000" top="0.34375000" bottom="0.52148438"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
</Ui>
